# ---------------------------------------------------------------------------------------------
# Cross-index query sample - environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored; this template is committed.
#
#   cp .env.example .env
#
# Everything here is optional. The sample reads, lowest precedence to highest:
#
#   appsettings.json  ->  appsettings.Development.json  ->  user secrets  ->  environment
#
# and this file feeds the last one, so anything set here wins over the JSON files. A variable
# already exported in your shell beats this file, so a one-off override still works.
#
# AUTHENTICATION: the sample uses DefaultAzureCredential and role-based access throughout.
# `az login` is normally all you need and no key below is required. The one exception is the
# knowledge base query-planning model - see that section for why.
# ---------------------------------------------------------------------------------------------


# --- Where the resources live -----------------------------------------------------------------
# Only needed if you are provisioning. `azd up` sets these for you; fill them in by hand if you
# are creating resources yourself or pointing at an existing service.

AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=

# Resource group holding the search service and the Foundry account. Created if absent.
AZURE_RESOURCE_GROUP=rg-cross-index-query

# Must support Azure AI Search serverless, agentic retrieval, and your chosen models.
AZURE_LOCATION=centralus

# azd environment name. Also used to derive resource names when provisioning.
AZURE_ENV_NAME=cross-index-query


# --- Azure AI Search ---------------------------------------------------------------------------

CIQ_Search__Endpoint=https://<your-search-service>.search.windows.net

# Leave empty to use DefaultAzureCredential, which is the recommended path. Set only if your
# environment forbids role-based access.
CIQ_Search__ApiKey=

# Index names. The stripe indexes are derived from the split mode automatically
# (books-genre-a / books-genre-b, books-temporal-2013-a, and so on), so only the single-index
# baseline is named here.
CIQ_Search__OracleIndex=books-oracle

# Knowledge base used by pattern 4. Also derived from the split mode.
CIQ_Search__KnowledgeBaseName=books-kb

CIQ_Search__SemanticConfigurationName=books-semantic
CIQ_Search__VectorProfileName=books-vector-profile


# --- Microsoft Foundry ---------------------------------------------------------------------------
# One account, one endpoint, one key. Every model this sample uses - embeddings, the offline batch
# jobs, the external reranker, and the optional query-planning model - lives on the same Foundry
# resource, so there is deliberately no second endpoint setting anywhere.

CIQ_Foundry__Endpoint=https://<your-foundry-account>.openai.azure.com/

# Leave empty to authenticate with DefaultAzureCredential. `az login` covers everything the sample
# calls itself.
#
# It becomes necessary for exactly one thing, and only on some tiers. When
# CIQ_Foundry__QueryPlanningDeployment is set, the SEARCH SERVICE calls Foundry on its own behalf
# rather than on yours, so your credential does not apply to that hop. The service would normally
# use a managed identity holding `Cognitive Services User`, but managed identity requires the
# Basic tier or higher - a serverless search service cannot hold one.
#
#   Serverless -> set this key; it is the only route to query planning.
#   Basic+     -> leave empty, assign the role, and the sample stays key-free.
CIQ_Foundry__ApiKey=

# Embedding model used to build the corpus vectors and to embed queries at search time.
# Changing this invalidates the committed vectors - they would occupy a different coordinate
# space, and comparing them across that boundary would still produce a number.
CIQ_Foundry__EmbeddingDeployment=text-embedding-3-small
CIQ_Foundry__EmbeddingModel=text-embedding-3-small
CIQ_Foundry__EmbeddingDimensions=1536

# A GlobalBatch chat deployment. Writes the corpus blurbs and grades the relevance judgments,
# both offline. Not needed to run the sample - both outputs are committed - so leave it empty
# unless you are regenerating the corpus or extending the judged set.
CIQ_Foundry__BatchDeployment=

# A standard chat deployment. Backs the external reranking strategy (pattern 2) and the second
# judge in the agreement check. Deliberately small and fast: pattern 2 pays per candidate at
# query time, so its cost profile is only representative if the model is one you would actually
# put in a query path.
CIQ_Foundry__ChatDeployment=gpt-5-nano

# A standard chat deployment attached to the knowledge base, enabling LLM query planning for
# pattern 4. Leave empty and the service is pinned to `minimal` reasoning effort, where no LLM
# participates at all and ordering comes from the semantic ranker - which is how every agentic
# number in the report was measured.
#
# Must be on the supported list: gpt-5, gpt-5-mini, gpt-5-nano, gpt-5.1, gpt-5.2, gpt-5.4,
# gpt-5.4-mini, gpt-5.4-nano, gpt-5.5, gpt-5.6-sol, gpt-5.6-terra, gpt-5.6-luna.
# A batch deployment will not work - query planning is interactive.
CIQ_Foundry__QueryPlanningDeployment=

# The service validates the model, not the deployment name. Falls back to the deployment name
# when empty, which is right whenever they match.
CIQ_Foundry__QueryPlanningModel=

# --- Corpus and split --------------------------------------------------------------------------

# Genre     - the intentional split; maximum vocabulary divergence between stripes.
# Random    - the control; statistically identical stripes, so nothing to correct.
# Temporal  - split-to-scale; freeze the old index, send new documents to a new one.
CIQ_Corpus__StripeMode=Genre

# Cut year for Temporal mode. 2004 gives a 525:1 imbalance, 2013 roughly balanced.
CIQ_Corpus__StripeYearCut=2013


# --- Evaluation ---------------------------------------------------------------------------------

CIQ_Evaluation__TopK=10

# Candidates retrieved per arm before merging.
CIQ_Evaluation__PerStripeK=50

# Equalized - stripes split PerStripeK between them, so both arms put the same number of
#             documents in front of the ranker. This is what makes the comparison fair.
# PerIndex  - each stripe gets PerStripeK, giving the striped arm twice the depth.
CIQ_Evaluation__CandidateBudget=Equalized

# Forces exact nearest-neighbour search in vector modes. Slower, and not how anyone runs in
# production - but it separates striping cost from HNSW approximation error, which otherwise
# arrive as one number.
CIQ_Evaluation__ExhaustiveVectorSearch=false

CIQ_Evaluation__OutputDirectory=results
CIQ_Evaluation__JudgmentsFile=judgments.json
